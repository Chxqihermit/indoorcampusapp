# Copy to .env.docker on the test server and adjust values.
# Usage: docker compose --env-file .env.docker up --build -d
#
# Note: Docker Compose also reads the project .env file for ${VAR} substitution.
# These DOCKER_* names avoid clashing with local Laragon DB_* settings in .env.

# Public URL of the app (required on test server — no trailing slash)
APP_URL=http://your-test-server:8000

# Use production settings on shared test servers
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=info

# Host port published for the app container
HTTP_PORT=8000

# Database credentials (must match between app and db services)
DOCKER_DB_DATABASE=campusnav
DOCKER_DB_USERNAME=campusnav
DOCKER_DB_PASSWORD=change-me-on-test-server
DOCKER_MYSQL_ROOT_PASSWORD=change-root-too

# Laravel app key — generate with: php artisan key:generate --show
# APP_KEY=base64:...
