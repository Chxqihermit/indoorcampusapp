{
  "expo": {
    "name": "CampusNav",
    "slug": "campusnav",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nust.campusnav",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CampusNav uses your location for outdoor navigation on campus."
      }
    },
    "android": {
      "package": "com.nust.campusnav",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusNav uses your location for outdoor navigation on campus."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:8000"
    }
  }
}
